ANTHROPIC_API_KEY=sk-...
ASSEMBLYAI_API_KEY=...
CARTESIA_API_KEY=...

# STT Provider Configuration
# Options: "assemblyai" (default) or "whisper"
STT_PROVIDER=assemblyai

# Whisper Model Configuration (only used when STT_PROVIDER=whisper)
# Options: tiny, base, small, medium, large (default: base)
WHISPER_MODEL=base
# Optional language code (e.g., en, ja, es). If not set, auto-detects.
# WHISPER_LANGUAGE=en
